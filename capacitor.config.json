{
  "appId": "app.mathroom.suhakjilmoon",
  "appName": "수학질문방",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f2e6fb",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#f2e6fb",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
